  "@type": "sc:Dataset",
  "name": "STRIDE-Bench-benchmark",
  "description": "Behavioral evaluation specs for the STRIDE-Bench crowd trajectory benchmark. Each row is one scene with a natural-language scenario description and a decomposition into behavioral evaluation questions (Trajectory Question Answering /  stride), each grounded in one or more measurement functions with expected value ranges and tolerances.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "license": "https://choosealicense.com/licenses/mit/",
  "url": "https://huggingface.co/datasets/ 0/ stride-benchmark",
  "version": "1.0.0",
  "datePublished": "2026-04-20",
  "keywords": [
    "crowd-simulation",
    "trajectory-evaluation",
    "pedestrian-dynamics",
    "benchmark",
    "behavioral-evaluation"
  ],
  "creator": {
    "@type": "Person",
    "name": "Anonymous (NeurIPS 2026 D&B submission, double-blind)"
  },
  "rai:dataCollectionType": [
    "Synthetic",
    "Simulation"
  ],
  "rai:personalSensitiveInformation": "None. The dataset contains no personal data, no images of identifiable individuals, and no real pedestrian tracks. All scenes are synthetic.",
  "rai:hasSyntheticData": true,
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "benchmark-jsonl",
      "name": "benchmark.jsonl",
      "description": "JSON Lines: one scene per line. Each line contains the scene's scenario description, behavioral category, decomposition reasoning, and a list of behavioral evaluation questions with measurement specs.",
      "contentUrl": "https://huggingface.co/datasets/ 0/ stride-benchmark/resolve/main/benchmark.jsonl",
      "encodingFormat": "application/jsonlines",
      "sha256": "8b44947d2e0281edfd2274ec403b7087af18e8ec1a04ffeb22837f1c90d52800",
      "contentSize": "7228940 B"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "benchmark",
      "name": "benchmark",
      "description": "One record per scene (one JSONL line).",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "benchmark/source_scene_id",
          "name": "source_scene_id",
          "description": "Unique scene identifier.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.source_scene_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/scenario_id",
          "name": "scenario_id",
          "description": "Reference to the physical scenario / environment.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.scenario_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/description",
          "name": "description",
          "description": "Natural-language description of the crowd behavior scenario.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.description"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/category",
          "name": "category",
          "description": "Behavioral category label (one of 11).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/location",
          "name": "location",
          "description": "Real-world location name.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.location"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/decomposition_reasoning",
          "name": "decomposition_reasoning",
          "description": "LLM reasoning for description -> behavioral properties.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.decomposition_reasoning"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/questions",
          "name": "questions",
          "description": "Nested list of {id, question, measurements:[{function, params, expected_result, expected_result_reasoning, delta_value}]}.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$.questions"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/_model",
          "name": "_model",
          "description": "LLM used to generate the benchmark (carried per-row).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$._model"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "benchmark/_n_scenes",
          "name": "_n_scenes",
          "description": "Total scenes in the dataset (carried per-row).",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "benchmark-jsonl"
            },
            "extract": {
              "jsonPath": "$._n_scenes"
            }
          }
        }
      ]
    }
  ]
}